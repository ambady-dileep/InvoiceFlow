# Copy to .env and replace the placeholders. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL container
POSTGRES_DB=invoiceflow
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=change-me

# Hostnames below are for code running in Compose.
# For code running on the host, use localhost:5433 and localhost:6380.

# Keep the credentials in sync with the POSTGRES_ values above.
DATABASE_URL=postgres://invoiceflow:change-me@db:5432/invoiceflow

# Redis: database 0 is the Celery broker, database 1 is the Django cache.
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000
